{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simba-site",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat", "enable_weak_ref"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simba-site",
      "migrations_dir": "migrations"
    }
  ]
}
